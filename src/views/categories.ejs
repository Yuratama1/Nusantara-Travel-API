<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Categories | Nusantara Travel API</title>

  <link rel="stylesheet" href="/css/style.css" />
</head>

<body>
  <div class="dashboard-layout">

    <aside class="sidebar">
      <div class="sidebar-brand">
        <div class="brand-icon">N</div>

        <div>
          <h2>Nusantara</h2>
          <span>Travel API</span>
        </div>
      </div>

      <nav class="sidebar-nav">
        <a href="/dashboard" class="nav-link">
          Dashboard
        </a>

        <a href="/admin/destinations" class="nav-link">
          Destinations
        </a>

        <a href="/admin/categories" class="nav-link active">
          Categories
        </a>

        <a href="/admin/api-keys" class="nav-link">
          API Keys
        </a>

        <a href="/documentation" class="nav-link">
          API Documentation
        </a>
      </nav>

      <button id="logoutButton" class="logout-button">
        Logout
      </button>
    </aside>

    <main class="dashboard-main">

      <header class="dashboard-header">
        <div>
          <h1>Category Management</h1>
          <p>Kelola kategori destinasi wisata.</p>
        </div>

        <button
          class="btn-action"
          id="openCreateButton"
        >
          + Tambah Category
        </button>
      </header>

      <section class="content-card">

        <div class="table-wrapper">
          <table>
            <thead>
              <tr>
                <th>ID</th>
                <th>Nama</th>
                <th>Deskripsi</th>
                <th>Total Destination</th>
                <th>Aksi</th>
              </tr>
            </thead>

            <tbody id="categoryTable">
              <tr>
                <td colspan="5">
                  Loading...
                </td>
              </tr>
            </tbody>
          </table>
        </div>

      </section>

    </main>
  </div>

  <div
    class="modal-overlay"
    id="categoryModal"
  >
    <div class="modal-card category-modal">

      <div class="modal-header">
        <h2 id="modalTitle">
          Tambah Category
        </h2>

        <button
          id="closeModalButton"
          class="modal-close"
        >
          ×
        </button>
      </div>

      <form id="categoryForm">

        <input
          type="hidden"
          id="categoryId"
        />

        <div class="form-group">
          <label>Nama Category</label>

          <input
            type="text"
            id="name"
            required
          />
        </div>

        <div class="form-group">
          <label>Deskripsi</label>

          <textarea
            id="description"
            rows="5"
          ></textarea>
        </div>

        <div
          id="formAlert"
          class="alert"
        ></div>

        <button
          type="submit"
          class="btn-action full-width"
        >
          Simpan
        </button>

      </form>

    </div>
  </div>

  <script src="/js/categories.js"></script>
</body>
</html>